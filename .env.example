# Copy this file to .env and fill in real values. Never commit .env.

# Database: leave empty to use a local SQLite file
DATABASE_URL=

# Supabase Storage for alert clips: leave empty to save clips locally
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=clips

# Frontend: where the backend lives
VITE_API_URL=http://localhost:8000
